# Базовый образ с установленным Go 1.24
FROM golang:1.24

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы зависимостей в контейнер
COPY go.mod go.sum ./

# Загружаем зависимости, чтобы потом быстрее билдилось
RUN go mod download

# По умолчанию запускаем проект через go run (без сборки бинаря)
CMD ["go", "run", "./cmd"]
